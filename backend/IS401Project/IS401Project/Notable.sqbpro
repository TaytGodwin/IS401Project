<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="Notable.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="1"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2271"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="3" parent="0"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Notes" custom_title="0" dock_id="1" table="4,5:mainNotes"/><dock_state state="000000ff00000000fd0000000100000002000002710000021ffc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000002710000010100ffffff000002710000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="Comments" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="85"/><column index="2" value="53"/><column index="3" value="54"/><column index="4" value="114"/><column index="5" value="300"/><column index="6" value="105"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Notes" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="53"/><column index="2" value="54"/><column index="3" value="159"/><column index="4" value="281"/><column index="5" value="101"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">INSERT INTO Notes (UserID, NoteContent, NoteTitle)
VALUES
(1, 'Sometimes life feels like a waiting game — for a job, for love, for answers. But I’ve learned that God’s timing is always perfect. Just like how Christ waited until the “fourth watch” to calm the storm for His disciples, He often lets us grow before He delivers us. I’m learning to trust that waiting doesn’t mean forgotten.', 'Trusting in the Lord''s Timing'),

(1, 'Today I realized that it’s not always the big spiritual moments that build my testimony. It’s the small things — reading a verse that speaks to me, feeling peace during prayer, or seeing someone’s kindness. Those tiny experiences are like spiritual compound interest.', 'Power in Small Moments'),

(1, 'When I feel overwhelmed with the future or unsure of what’s next, I remind myself that fear isn’t from God. Faith is. As President Nelson said, “The joy we feel has little to do with the circumstances of our lives and everything to do with the focus of our lives.”', 'Choosing Faith Over Fear'),

(1, 'I used to read just to check the box, but lately, I’ve been slowing down, asking, “How does this apply to me right now?” The Book of Mormon has started to feel more like a conversation than a chore. It’s wild how words written thousands of years ago feel like they’re for me, today.', 'The Book of Mormon and Me'),

(1, 'The more I go to the temple, the more I realize that covenants aren’t just spiritual contracts — they’re lifelines. They remind me that I’m never alone and that God has committed to help me become who I’m meant to be, even when I mess up.', 'Covenant Connections');</sql><current_tab id="0"/></tab_sql></sqlb_project>
